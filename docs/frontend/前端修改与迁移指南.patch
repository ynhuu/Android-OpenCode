+import { createSignal, onCleanup } from "solid-js"
+import { showToast } from "@opencode/ui/toast"
+import { createKeyed, useExtension, type MountedSession, type SessionScreen } from "../sdk"
+
+export function createFileTreeRefresh(
+  props: { session: MountedSession; screen: SessionScreen },
+  active: () => boolean,
+) {
+  const ctx = useExtension()
+  const [loading, setLoading] = createSignal(false)
+  let disposed = false
+  onCleanup(() => (disposed = true))
+
+  const refresh = async () => {
+    if (loading()) return
+    const file = props.screen.file
+    const root = file.root
+    const current = () => !disposed && !ctx.signal.aborted && props.screen.file === file && file.root === root
+    const sync = async (path: string): Promise<void> => {
+      await file.tree.sync(path, { force: true })
+      if (!current()) return
+      await Promise.all(
+        file.tree
+          .list(path)
+          .filter((node) => node.type === "directory" && file.tree.state(node.path)?.expanded)
+          .map((node) => sync(node.path)),
+      )
+    }
+    setLoading(true)
+    await sync("")
+      .catch(() => {
+        if (current()) showToast({ variant: "error", title: ctx.t("common.requestFailed") })
+      })
+      .finally(() => {
+        if (!disposed && !ctx.signal.aborted) setLoading(false)
+      })
+  }
+
+  // Re-entering the file view refreshes directory listings, not loaded file contents.
+  createKeyed(
+    () => (active() && props.session.server.connected ? props.screen.file.root : undefined),
+    () => void refresh(),
+  )
+}
